# MicroLIMS Backend Configuration

PORT=5000
NODE_ENV=development

# PostgreSQL Connection (Primary)
DATABASE_URL=postgresql://microlims_user:microlims_dev_password@localhost:5432/microlims_db
PGHOST=localhost
PGPORT=5432
PGUSER=microlims_user
PGPASSWORD=microlims_dev_password
PGDATABASE=microlims_db

# Redis Configuration (Optional / Fallback supported)
REDIS_URL=redis://localhost:6379

# Authentication & JWT
JWT_ACCESS_SECRET=microlims_access_super_secret_key_demo_2026_x99!
JWT_REFRESH_SECRET=microlims_refresh_super_secret_key_demo_2026_z88!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
